<section class="section">
  <div class="page-width" style="max-width:760px">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.text }}</p>
    <div class="contact-options">
      {%- if section.settings.contact_email != blank -%}<a class="button" href="mailto:{{ section.settings.contact_email | escape }}">{{ 'contact.form.write_email' | t }}</a>{%- endif -%}
      {%- if section.settings.whatsapp_url != blank -%}<a class="button" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">{{ 'contact.form.write_whatsapp' | t }}</a>{%- endif -%}
    </div>
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}<p class="form-message" role="status">{{ 'contact.form.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label class="label" for="ContactName">{{ 'contact.form.name' | t }}</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name"></div>
      <div class="field"><label class="label" for="ContactEmail">{{ 'contact.form.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div>
      <div class="field"><label class="label" for="ContactBody">{{ 'contact.form.message' | t }}</label><textarea id="ContactBody" name="contact[body]" required></textarea></div>
      <button class="button button--primary" type="submit">{{ 'contact.form.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .contact-options { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1.5rem 2rem; }
  @media (max-width: 640px) { .contact-options .button { width: 100%; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "contact_email", "label": "Correo de contacto", "default": "marianaordonez04@gmail.com" },
    { "type": "url", "id": "whatsapp_url", "label": "Enlace de WhatsApp" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contacto" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Escríbeme." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Cuéntame qué necesitas y te responderé personalmente." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
