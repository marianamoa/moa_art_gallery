<section class="section{% if section.settings.deep_background %} section--deep{% endif %}" aria-labelledby="NewsletterTitle-{{ section.id }}">
  <div class="newsletter page-width">
    <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 id="NewsletterTitle-{{ section.id }}">{{ section.settings.heading }}</h2><p class="lead">{{ section.settings.text }}</p></div>
    <div>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.email' | t }}</label>
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'general.newsletter.email' | t }}" autocomplete="email" required>
        <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
      {% endform %}
      {%- if form.posted_successfully? -%}<p class="form-message" role="status">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:schema.sections.newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Desde el taller" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Obra nueva, antes que nadie." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "La lista ve los originales la tarde anterior y se entera cuando se abren los lugares de encargo." },
    { "type": "checkbox", "id": "deep_background", "label": "Use deep paper background", "default": true }
  ],
  "presets": [{ "name": "t:schema.sections.newsletter" }]
}
{% endschema %}

