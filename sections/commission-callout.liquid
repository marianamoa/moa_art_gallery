<section class="commission-callout section--deep" aria-labelledby="CommissionTitle-{{ section.id }}">
  <div class="commission-callout__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="CommissionTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p class="lead">{{ section.settings.text }}</p>
    <div class="commission-facts">
      <div><strong>{{ section.settings.starting_price }}</strong><span class="meta">{{ 'home.price_from' | t }}</span></div>
      <div><strong>{{ section.settings.timeline }}</strong><span class="meta">{{ 'home.in_studio' | t }}</span></div>
    </div>
    {%- if section.settings.link != blank -%}<a class="button button--primary" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  <div class="commission-callout__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '520, 800, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt }}
    {%- else -%}
      {%- assign commission_fallback_alt = 'home.commission_fallback_alt' | t -%}
      <img src="{{ 'commission-dog.jpg' | asset_url }}" width="1600" height="1200" loading="lazy" alt="{{ commission_fallback_alt | escape }}">
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .commission-callout__media { position: relative; overflow: hidden; container-type: size; min-height: 420px; }
  .commission-callout__media img { position: absolute; top: 50%; left: 50%; width: 100cqh; height: 100cqw; max-width: none; object-fit: cover; transform: translate(-50%, -50%) rotate(90deg); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:schema.sections.commission_callout",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Encargos" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Que te pinte <em>algo tuyo.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Animales y objetos a partir de tus fotos, siempre sobre fondo blanco." },
    { "type": "text", "id": "starting_price", "label": "Starting price", "default": "$60.000 COP" },
    { "type": "text", "id": "timeline", "label": "Timeline", "default": "2–4" },
    { "type": "text", "id": "link_label", "label": "Button", "default": "Empezar mi encargo" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "t:schema.sections.commission_callout" }]
}
{% endschema %}
