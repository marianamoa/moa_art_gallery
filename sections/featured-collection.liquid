<section class="section{% if section.settings.deep_background %} section--deep{% endif %}" aria-labelledby="FeaturedTitle-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 id="FeaturedTitle-{{ section.id }}">{{ section.settings.heading }}</h2></div>
      {%- if section.settings.collection != blank -%}<a class="text-link" href="{{ section.settings.collection.url }}">{{ section.settings.link_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
    <div class="product-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}{% render 'product-card', product: product, index: forloop.index %}{%- endfor -%}
      {%- else -%}
        {%- for index in (1..4) -%}
          <article class="product-card"><div class="product-card__media"><div class="placeholder">{{ 'product-' | append: index | placeholder_svg_tag }}<span class="placeholder__label meta">{{ 'home.artwork_placeholder' | t }}</span></div></div><div class="product-card__content"><h3 class="product-card__title">{{ 'home.artwork_title' | t }}</h3><p class="product-card__meta">{{ 'home.artwork_meta' | t }}</p></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:schema.sections.featured_collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pieza única" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Originales disponibles" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Ver toda la colección" },
    { "type": "checkbox", "id": "deep_background", "label": "Use deep paper background", "default": false }
  ],
  "presets": [{ "name": "t:schema.sections.featured_collection" }]
}
{% endschema %}

