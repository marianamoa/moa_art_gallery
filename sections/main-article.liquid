<article class="page-width">
  <header class="page-header">
    <p class="eyebrow">{{ blog.title }} · {{ article.published_at | time_tag: format: 'date' }}</p>
    <h1>{{ article.title }}</h1>
  </header>
  {%- if article.image -%}{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '640, 960, 1400, 1800', sizes: '100vw', alt: article.image.alt | default: article.title }}{%- endif -%}
  <div class="page-content rte">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}

