{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign edition_size = current_variant.metafields.custom.edition_size.value | default: product.metafields.custom.edition_size.value
  assign current_inventory = current_variant.inventory_quantity | at_least: 0
  assign is_original = false
  assign is_digital = false
  assign is_cards = false
  assign is_poster = false
  assign product_type_lower = product.type | downcase
  if product_type_lower == 'afiches' or template.suffix == 'edition'
    assign is_poster = true
  endif
  if product.tags contains 'original'
    assign is_original = true
  endif
  if product.tags contains 'digital'
    assign is_digital = true
  endif
  if product_type_lower contains 'tarjet'
    assign is_cards = true
  elsif product.handle contains 'tarjeta'
    assign is_cards = true
  elsif template.suffix == 'cards'
    assign is_cards = true
  elsif product.tags contains 'cards'
    assign is_cards = true
  endif
-%}

<section class="product page-width" data-product-root data-poster="{{ is_poster }}" data-cards="{{ is_cards }}" data-poster-discount="1000000" data-selection-label="{{ 'products.product.selection_total' | t: count: '[count]' }}" data-savings-label="{{ 'cart.general.savings' | t }}" data-per-card-label="{{ 'products.product.per_card' | t }}" data-card-count-label="{{ 'products.product.cards_total' | t: count: '[count]' }}" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}-{{ localization.country.iso_code }}" data-show-currency-code="{{ settings.show_currency_codes }}" data-remaining-label="{{ 'products.product.remaining' | t: count: '[count]', total: '[total]' }}" data-added-label="{{ 'products.product.added_to_shopping_cart' | t }}">
  <div class="product-gallery-shell" style="--mobile-image-zoom: {{ section.settings.mobile_image_zoom | default: 100 | divided_by: 100.0 }}; --mobile-image-fit: {{ section.settings.mobile_image_fit | default: 'contain' }}">
  <div id="ProductGallery-{{ section.id }}" class="product-gallery" tabindex="0" aria-label="{{ product.title | escape }}">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <div class="product-gallery__item">
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '420, 720, 1100, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
          {%- else -%}
            {{ media | media_tag: image_size: '1200x', controls: true }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product-gallery__item placeholder">{{ 'product-1' | placeholder_svg_tag }}<span class="placeholder__label meta">{{ product.title }}</span></div>
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product-gallery-controls">
      <button type="button" data-gallery-prev aria-controls="ProductGallery-{{ section.id }}" aria-label="{{ 'products.product.previous_image' | t }}">←</button>
      <span class="product-gallery-progress" aria-live="polite"><span data-gallery-current>1</span> / {{ product.media.size }}</span>
      <button type="button" data-gallery-next aria-controls="ProductGallery-{{ section.id }}" aria-label="{{ 'products.product.next_image' | t }}">→</button>
      <span class="product-gallery-hint">{{ 'products.product.swipe_images' | t }}</span>
    </div>
  {%- endif -%}
  </div>

  <div class="product-info">
    <p class="eyebrow">
      {%- if is_original -%}{{ 'products.product.unique' | t }}
      {%- elsif is_digital -%}{{ 'products.product.digital' | t }}
      {%- elsif edition_size -%}{{ 'products.product.edition' | t: count: edition_size }}
      {%- else -%}{{ product.type }}{%- endif -%}
    </p>
    <h1>{{ product.title }}</h1>
    <div class="price-large" data-product-price>{% render 'money', amount: current_variant.price %}</div>
    <p class="muted">{{ 'products.product.shipping_checkout' | t }}</p>
    {%- if product.description != blank -%}<div class="product-info__description rte">{{ product.description }}</div>{%- endif -%}

    {%- assign product_form_id = 'ProductForm-' | append: section.id -%}
    {%- form 'product', product, id: product_form_id, class: 'product-form' -%}
      <select class="visually-hidden" name="id" aria-label="{{ 'products.product.variant' | t }}">
        {%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}>{{ variant.title }}</option>{%- endfor -%}
      </select>

      {%- unless product.has_only_default_variant -%}
        <div class="product-options">
          {%- for option in product.options_with_values -%}
            <fieldset>
              <legend class="label">{{ 'products.product.choose_option' | t: option: option.name }}</legend>
              <div class="option-grid">
                {%- for value in option.values -%}
                  <div class="option-card">
                    <input id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" type="radio" name="option{{ option.position }}" value="{{ value | escape }}" data-option-input{% if option.selected_value == value %} checked{% endif %}>
                    <label{% if is_cards and option.position == 1 %} class="card-pack-option"{% endif %} for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}"><span class="card-pack-details">{{ value }}
                      {%- if is_cards and option.position == 1 -%}
                        {%- assign card_option_name = value.name | default: value | append: '' -%}
                        {%- assign card_variant = value.variant -%}
                        {%- if card_variant == blank -%}{%- assign card_variant = product.variants | where: 'option1', card_option_name | first -%}{%- endif -%}
                        {%- assign card_count = card_option_name | plus: 0 -%}
                        {%- assign base_card_count = product.variants.first.option1 | plus: 0 -%}
                        {%- if card_count > 0 and base_card_count > 0 -%}
                          {%- assign unit_price = card_variant.price | divided_by: card_count -%}
                          {%- assign reference_unit_price = product.variants.first.price | divided_by: base_card_count -%}
                          {%- assign card_savings = reference_unit_price | times: card_count | minus: card_variant.price -%}
                          <span class="card-option-price">{% render 'money', amount: unit_price %} {{ 'products.product.per_card' | t }}</span>
                          {%- if card_savings > 0 -%}<span class="card-option-price">{{ 'cart.general.savings' | t }} {% render 'money', amount: card_savings %}</span>{%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                      </span>
                      {%- if is_cards and option.position == 1 and card_variant != blank -%}
                        <strong class="card-pack-total" data-card-pack-total data-pack-price="{{ card_variant.price }}">{% render 'money', amount: card_variant.price %}</strong>
                      {%- endif -%}
                    </label>
                  </div>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- unless is_original -%}
      <div class="stock-meter{% if current_inventory <= 5 %} low{% endif %}" data-stock-meter{% unless current_variant.inventory_management %} hidden{% endunless %}>
        <p class="meta" data-stock-label>
          {%- if edition_size -%}{{ 'products.product.remaining' | t: count: current_inventory, total: edition_size }}{%- else -%}{{ current_inventory }}{%- endif -%}
        </p>
        <div class="stock-meter__track"><span class="stock-meter__bar" data-stock-bar style="width:{% if edition_size %}{{ current_inventory | times: 100.0 | divided_by: edition_size | at_most: 100 }}{% else %}100{% endif %}%"></span></div>
      </div>
      {%- endunless -%}

      {%- unless is_original or is_digital or is_cards -%}
        <label class="label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
        <div class="quantity" data-quantity>
          <button type="button" data-quantity-action="decrease" aria-label="{{ 'accessibility.decrease_quantity' | t }}">−</button>
          <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
          <button type="button" data-quantity-action="increase" aria-label="{{ 'accessibility.increase_quantity' | t }}">+</button>
        </div>
      {%- else -%}
        <input type="hidden" name="quantity" value="1">
      {%- endunless -%}

      {%- if is_poster -%}
        <div class="product-selection-summary" aria-live="polite" aria-atomic="true">
          <p class="meta" data-selection-total>{{ 'products.product.selection_total' | t: count: 1 }}</p>
          <strong class="price-large" data-selection-price>{% render 'money', amount: current_variant.price %}</strong>
          <p class="meta" data-selection-savings hidden></p>
        </div>
      {%- endif -%}

      <div class="product-form__cart-bar">
        <button class="button button--primary product-form__submit" type="submit" data-product-submit data-add-label="{{ 'products.product.add_to_shopping_cart' | t }}" data-sold-label="{{ 'products.product.sold_out' | t }}"{% unless current_variant.available %} disabled{% endunless %}>
        <span>{% if current_variant.available %}{{ 'products.product.add_to_shopping_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
      </button>
      <button class="button product-form__buy-now" type="submit" name="return_to" value="/checkout" data-buy-now{% unless current_variant.available %} disabled{% endunless %}>{{ 'products.product.buy_now' | t }}</button>
      <p class="form-message" data-product-message role="status" hidden></p>
      </div>
    {%- endform -%}

    {%- unless is_original or is_cards or is_digital -%}<p class="muted">{{ 'products.product.poster_pair_note' | t }}</p>{%- endunless -%}

    <dl class="product-details">
      {%- if product.metafields.custom.dimensions.value != blank -%}<div><dt>{{ 'product_details.dimensions' | t }}</dt><dd>{{ product.metafields.custom.dimensions.value }}</dd></div>{%- endif -%}
      {%- if product.metafields.custom.medium.value != blank -%}<div><dt>{{ 'product_details.medium' | t }}</dt><dd>{{ product.metafields.custom.medium.value }}</dd></div>{%- endif -%}
      {%- if product.metafields.custom.paper.value != blank -%}<div><dt>{{ 'product_details.paper' | t }}</dt><dd>{{ product.metafields.custom.paper.value }}</dd></div>{%- endif -%}
      {%- if product.metafields.custom.shipping_note.value != blank -%}<div><dt>{{ 'product_details.shipping' | t }}</dt><dd>{{ product.metafields.custom.shipping_note.value }}</dd></div>{%- endif -%}
    </dl>

    {%- for block in section.blocks -%}{%- render block -%}{%- endfor -%}
  </div>

  <script type="application/json" data-variants-json>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "options": {{ variant.options | json }},
          "cardCount": {{ variant.option1 | plus: 0 | json }},
          "price": {{ variant.price | json }},
          "available": {{ variant.available | json }},
          "tracked": {% if variant.inventory_management %}true{% else %}false{% endif %},
          "inventoryQuantity": {{ variant.inventory_quantity | json }},
          "editionSize": {{ variant.metafields.custom.edition_size.value | default: product.metafields.custom.edition_size.value | default: 0 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{% stylesheet %}
  .option-card label.card-pack-option { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; }
  .card-pack-total { font-family: var(--font-heading); font-size: clamp(1.2rem, 2vw, 1.7rem); font-weight: 400; text-align: right; line-height: 1.2; }
  .card-option-price { display: block; font-size: .8rem; font-weight: 400; margin-top: .35rem; }
  .product-selection-summary { margin-block: 1rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent); background: var(--paper-deep); }
  .product-selection-summary p { margin: 0 0 .5rem; }
  .product-selection-summary .price-large { display: block; font-size: 1.8rem; margin: 0; }
  .product-selection-summary [data-selection-savings] { margin: .65rem 0 0; }
  .product-form__cart-bar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .product-form__cart-bar .button { padding-inline: .75rem; }
  .product-form__cart-bar .form-message { grid-column: 1 / -1; }
  .product-gallery-shell { min-width: 0; }
  .product-gallery-controls { display: none; }
  @media (max-width: 990px) {
    .product-gallery-shell .product-gallery { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 18px; padding-inline: 18px; background: transparent; scrollbar-width: none; }
    .product-gallery::-webkit-scrollbar { display: none; }
    .product-gallery__item { flex: 0 0 92%; min-width: 0; overflow: hidden; scroll-snap-align: start; }
    .product-gallery__item:only-child { flex-basis: 100%; }
    .product-gallery-shell .product-gallery__item img { aspect-ratio: 4/5; object-fit: var(--mobile-image-fit); transform: scale(var(--mobile-image-zoom)); }
    .product-gallery__item video, .product-gallery__item iframe, .product-gallery__item model-viewer { width: 100%; height: 100%; aspect-ratio: 4/5; }
    .product-gallery-controls { display: flex; align-items: center; justify-content: center; gap: 12px; padding-top: 8px; flex-wrap: wrap; }
    .product-gallery-controls button { width: 44px; height: 44px; border: 1px solid var(--ink-muted); background: transparent; font-size: 1.2rem; }
    .product-gallery-controls button:disabled { opacity: .35; }
    .product-gallery-progress { min-width: 44px; text-align: center; font-size: .85rem; }
    .product-gallery-hint { width: 100%; text-align: center; color: var(--ink-muted); font-size: .8rem; }
    body:has([data-product-root]) { padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px)); }
    .product-form__cart-bar { position: fixed; inset: auto 0 0; z-index: 25; background: var(--paper); border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); padding: 12px 18px calc(12px + env(safe-area-inset-bottom, 0px)); box-shadow: 0 -4px 16px rgba(0, 0, 0, .06); }
    .product-form__cart-bar .product-form__submit { min-height: 48px; margin: 0; }
    .product-form__cart-bar .button { font-size: .65rem; letter-spacing: .04em; }
    .product-form__cart-bar .form-message { margin: .5rem 0 0; font-size: .85rem; }
    body:has(.mobile-menu[open]) .product-form__cart-bar { visibility: hidden; }
  }
{% endstylesheet %}

{% javascript %}
  function initProductGalleries(root = document) {
    root.querySelectorAll('.product-gallery-shell').forEach(shell => {
      const gallery = shell.querySelector('.product-gallery');
      const slides = [...gallery.children];
      const previous = shell.querySelector('[data-gallery-prev]');
      const next = shell.querySelector('[data-gallery-next]');
      if (!previous || shell.dataset.galleryReady) return;
      shell.dataset.galleryReady = 'true';
      let current = 0;
      const update = () => {
        const left = gallery.getBoundingClientRect().left + 18;
        current = slides.reduce((best, slide, index) => Math.abs(slide.getBoundingClientRect().left - left) < Math.abs(slides[best].getBoundingClientRect().left - left) ? index : best, 0);
        shell.querySelector('[data-gallery-current]').textContent = current + 1;
        previous.disabled = current === 0;
        next.disabled = current === slides.length - 1;
      };
      const move = offset => {
        const slide = slides[Math.max(0, Math.min(slides.length - 1, current + offset))];
        const distance = slide.getBoundingClientRect().left - gallery.getBoundingClientRect().left - 18;
        gallery.scrollBy({ left: distance, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      };
      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      gallery.addEventListener('scroll', update, { passive: true });
      gallery.addEventListener('keydown', event => {
        if (event.target !== gallery) return;
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1); }
      });
      new ResizeObserver(update).observe(gallery);
      update();
    });
  }
  initProductGalleries();
  document.addEventListener('shopify:section:load', event => initProductGalleries(event.target));
{% endjavascript %}

{% schema %}
{
  "name": "t:schema.sections.main_product",
  "settings": [
    { "type": "range", "id": "mobile_image_zoom", "label": "Zoom de imágenes en móvil", "min": 100, "max": 180, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "mobile_image_fit", "label": "Encuadre de imágenes en móvil", "options": [{ "value": "contain", "label": "Mostrar imagen completa" }, { "value": "cover", "label": "Llenar el espacio" }], "default": "contain" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": false }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
