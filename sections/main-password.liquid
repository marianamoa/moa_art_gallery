<section class="empty-state page-width">
  <p class="eyebrow">{{ shop.name }}</p>
  <h1>{{ section.settings.heading }}</h1>
  <p class="lead">{{ section.settings.text }}</p>
  {% form 'storefront_password' %}
    <label class="visually-hidden" for="Password">{{ 'templates.password.password' | t }}</label>
    <input id="Password" type="password" name="password" placeholder="{{ 'templates.password.password' | t }}">
    <button class="button button--primary" type="submit">{{ 'templates.password.enter' | t }}</button>
    {{ form.errors | default_errors }}
  {% endform %}
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "La tienda abrirá pronto." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Estoy preparando la primera colección." }
  ]
}
{% endschema %}
