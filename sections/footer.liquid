<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__inner">
      <div>
        <div class="site-footer__brand">{{ settings.brand_name | default: shop.name }}</div>
        {%- if section.settings.tagline != blank -%}<p class="muted">{{ section.settings.tagline }}</p>{%- endif -%}
      </div>
      <nav aria-label="{{ 'footer.shop_navigation' | t }}">
        {%- for link in section.settings.shop_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
      <nav aria-label="{{ 'footer.information_navigation' | t }}">
        {%- assign has_instagram_link = false -%}
        {%- assign has_tiktok_link = false -%}
        {%- for link in section.settings.info_menu.links -%}
          {%- assign social_name = link.title | downcase | strip -%}
          {%- if social_name == 'instagram' -%}{%- assign has_instagram_link = true -%}{%- endif -%}
          {%- if social_name == 'tiktok' -%}{%- assign has_tiktok_link = true -%}{%- endif -%}
          {%- if social_name == 'instagram' or social_name == 'tiktok' -%}
            <a class="footer-social-link" href="{{ link.url }}" aria-label="{{ link.title | escape }}" rel="noopener">{% render 'social-icon', platform: social_name %}</a>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
        {%- if settings.instagram_url != blank and has_instagram_link == false -%}<a class="footer-social-link" href="{{ settings.instagram_url }}" aria-label="Instagram" rel="noopener">{% render 'social-icon', platform: 'instagram' %}</a>{%- endif -%}
        {%- if settings.tiktok_url != blank and has_tiktok_link == false -%}<a class="footer-social-link" href="{{ settings.tiktok_url }}" aria-label="TikTok" rel="noopener">{% render 'social-icon', platform: 'tiktok' %}</a>{%- endif -%}
      </nav>
    </div>
    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if shop.policies.size > 0 -%}
        <nav class="site-footer__policies" aria-label="{{ 'footer.policies_navigation' | t }}">
          {%- for policy in shop.policies -%}
            {%- if policy.body != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
      <span>{{ 'footer.made_slowly' | t }}</span>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer nav a.footer-social-link { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: 0 .35rem 0 0; vertical-align: middle; }
  .footer-social-icon { display: block; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:schema.sections.footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Acuarelas, pintadas a mano" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu", "default": "main-menu" },
    { "type": "link_list", "id": "info_menu", "label": "Information menu", "default": "footer" }
  ]
}
{% endschema %}
