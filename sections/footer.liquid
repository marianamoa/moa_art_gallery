<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__inner">
      <div>
        <div class="site-footer__brand">{{ settings.brand_name | default: shop.name }}</div>
        {%- if section.settings.tagline != blank -%}<p class="muted">{{ section.settings.tagline }}</p>{%- endif -%}
      </div>
      <nav aria-label="{{ 'footer.shop_navigation' | t }}">
        {%- for link in section.settings.shop_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
      <nav aria-label="{{ 'footer.information_navigation' | t }}">
        {%- for link in section.settings.info_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}" rel="noopener">Instagram</a>{%- endif -%}
      </nav>
    </div>
    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ 'footer.made_slowly' | t }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:schema.sections.footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Acuarelas, pintadas despacio." },
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu" },
    { "type": "link_list", "id": "info_menu", "label": "Information menu" }
  ]
}
{% endschema %}

