<section class="page-width">
  <header class="page-header"><p class="eyebrow">{{ shop.name }}</p><h1>{{ blog.title }}</h1></header>
  {% paginate blog.articles by 12 %}
    <div class="product-grid">
      {%- for article in blog.articles -%}
        <article class="product-card">
          <a class="product-card__link" href="{{ article.url }}">
            <div class="product-card__media">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 540, 900', alt: article.image.alt | default: article.title }}{%- else -%}<div class="placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{%- endif -%}</div>
            <div class="product-card__content"><h2 class="product-card__title">{{ article.title }}</h2><p class="product-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p></div>
          </a>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}

