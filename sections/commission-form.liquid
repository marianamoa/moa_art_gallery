<section class="section commission-page" aria-labelledby="CommissionFormTitle-{{ section.id }}">
  <div class="page-width">
    <header class="page-header">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 id="CommissionFormTitle-{{ section.id }}">{{ section.settings.heading }}</h1>
      <div class="lead rte">{{ section.settings.intro }}</div>
      <div class="lead rte commission-contact-copy">{{ section.settings.contact_text }}</div>
      {%- assign commission_contact_url = section.settings.contact_link | default: pages.contact.url -%}
      {%- if commission_contact_url != blank -%}<a class="button button--primary commission-contact-cta" href="{{ commission_contact_url }}">{{ section.settings.contact_label | escape }}</a>{%- endif -%}
    </header>

    <div class="commission-form" data-commission-calculator data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}-{{ localization.country.iso_code }}" data-show-currency-code="{{ settings.show_currency_codes }}" data-timeline-label="{{ 'commissions.ready_in' | t: count: '[count]' }}">
      <div>
        {% form 'contact', id: 'CommissionContactForm' %}
          {%- if form.posted_successfully? -%}<p class="form-message" role="status">{{ 'contact.form.success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}

          <section class="commission-step">
            <div class="commission-step__heading"><span class="meta">01</span><h2>{{ 'contact.form.size' | t }}</h2></div>
            <div class="choice-grid choice-grid--sizes">
              <div class="choice"><input id="SizeA5" type="radio" name="commission_size" value="12,5 × 18 cm" data-detail-size="small" data-price="{{ section.settings.a5_price }}" data-weeks="2" checked><label for="SizeA5">12,5 × 18 cm<small> {% render 'money', amount: section.settings.a5_price %}</small></label></div>
              <div class="choice"><input id="SizeA4" type="radio" name="commission_size" value="22,9 × 30,5 cm" data-detail-size="large" data-price="{{ section.settings.a4_price }}" data-weeks="3"><label for="SizeA4">22,9 × 30,5 cm<small> {% render 'money', amount: section.settings.a4_price %}</small></label></div>
            </div>
          </section>

          <section class="commission-step">
            <div class="commission-step__heading"><span class="meta">02</span><h2>{{ 'contact.form.subjects' | t }}</h2></div>
            <p class="muted">{{ 'commissions.elements_description' | t }} <em>{{ 'commissions.elements_quote_note' | t }}</em></p>
            <p>{{ 'commissions.elements_question' | t }}</p>
            <div class="choice-grid choice-grid--elements">
              <div class="choice"><input id="Subject1" type="radio" name="commission_subjects" value="1" data-price="0" checked><label for="Subject1">{{ 'commissions.one_element' | t }}<small>{{ 'commissions.included' | t }}</small></label></div>
              <div class="choice"><input id="Subject2" type="radio" name="commission_subjects" value="2" data-price="{{ section.settings.extra_subject_price }}"><label for="Subject2">{{ 'commissions.elements' | t: count: 2 }}<small>+{% render 'money', amount: section.settings.extra_subject_price %}</small></label></div>
              {%- assign third_subject_price = section.settings.extra_subject_price | times: 2 -%}
              <div class="choice"><input id="Subject3" type="radio" name="commission_subjects" value="3" data-price="{{ third_subject_price }}"><label for="Subject3">{{ 'commissions.elements' | t: count: 3 }}<small>+{% render 'money', amount: third_subject_price %}</small></label></div>
              {%- assign fourth_subject_price = section.settings.extra_subject_price | times: 3 -%}
              {%- capture fourth_subject_amount -%}{% render 'money', amount: fourth_subject_price %}{%- endcapture -%}
              <div class="choice"><input id="Subject4" type="radio" name="commission_subjects" value="4+" data-price="{{ fourth_subject_price }}"><label for="Subject4">{{ 'commissions.four_plus_elements' | t }}<small>{{ 'commissions.extra_from' | t: price: fourth_subject_amount }}</small></label></div>
            </div>
          </section>

          <section class="commission-step">
            <div class="commission-step__heading"><span class="meta">03</span><h2>{{ 'contact.form.finish' | t }}</h2></div>
            <div class="choice-grid choice-grid--detail">
              <div class="choice"><input id="FinishLoose" type="radio" name="commission_finish" value="Esencial" data-price="0" data-weeks="2" checked><label for="FinishLoose">{{ 'commissions.loose' | t }}<small>{{ 'commissions.included' | t }}</small><span class="choice__description">{{ 'commissions.essential_description' | t }}</span></label></div>
              <div class="choice"><input id="FinishBalanced" type="radio" name="commission_finish" value="Detallado" data-price="{{ section.settings.balanced_price }}" data-price-small="{{ section.settings.balanced_price }}" data-price-large="{{ section.settings.balanced_large_price }}" data-weeks="3"><label for="FinishBalanced">{{ 'commissions.balanced' | t }}<small data-detail-price>+{% render 'money', amount: section.settings.balanced_price %}</small><span class="choice__description">{{ 'commissions.detailed_description' | t }}</span></label></div>
              <div class="choice"><input id="FinishFine" type="radio" name="commission_finish" value="Minucioso" data-price="{{ section.settings.fine_price }}" data-price-small="{{ section.settings.fine_price }}" data-price-large="{{ section.settings.fine_large_price }}" data-weeks="4"><label for="FinishFine">{{ 'commissions.fine' | t }}<small data-detail-price>+{% render 'money', amount: section.settings.fine_price %}</small><span class="choice__description">{{ 'commissions.meticulous_description' | t }}</span></label></div>
            </div>
          </section>

          <section class="commission-step">
            <div class="commission-step__heading"><span class="meta">04</span><h2>{{ 'contact.form.photos' | t }}</h2></div>
            <p class="muted">{{ 'commissions.photo_note' | t }}</p>
            <div class="field"><label class="label" for="CommissionName">{{ 'contact.form.name' | t }}</label><input id="CommissionName" type="text" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label class="label" for="CommissionEmail">{{ 'contact.form.email' | t }}</label><input id="CommissionEmail" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="field"><label class="label" for="CommissionBody">{{ 'contact.form.message' | t }}</label><textarea id="CommissionBody" name="contact[body]"></textarea></div>
            <input type="hidden" name="contact[Tamaño]" data-hidden-size>
            <input type="hidden" name="contact[Número de elementos]" data-hidden-subjects>
            <input type="hidden" name="contact[Nivel de detalle]" data-hidden-finish>
            <input type="hidden" name="contact[Presupuesto estimado]" data-hidden-estimate>
            <button class="button button--primary" type="submit">{{ 'commissions.send_details' | t }}</button>
            <p class="muted">{{ 'commissions.next_step' | t }}</p>
          </section>
        {% endform %}

        {%- if section.blocks.size > 0 -%}
          <div class="commission-step">
            <p class="label">{{ 'commissions.upload_app' | t }}</p>
            {%- for block in section.blocks -%}{%- render block -%}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <aside class="commission-summary" aria-live="polite">
        <p class="eyebrow">{{ 'commissions.your_piece' | t }}</p>
        <div class="commission-summary__row"><span>{{ 'contact.form.estimate' | t }}</span><strong class="commission-summary__total" data-commission-total></strong></div>
        <div class="commission-summary__row"><span>{{ 'contact.form.timeline' | t }}</span><strong data-commission-timeline></strong></div>
        <p>{{ 'commissions.summary_note' | t }}</p>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:schema.sections.commission_form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Encargos"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hagamos una <em>para ti.</em>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>El tamaño, la cantidad de elementos y el nivel de detalle ayudan a definir el precio y el tiempo de creación. Aquí puedes explorar las opciones y tener una referencia del valor de tu encargo. <strong>No estás realizando ningún pago.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Invitación a conversar",
      "default": "<p>¿Tienes una idea diferente o quieres incluir algo especial? <strong>También puedes escribirme directamente y podemos conversar los detalles y crear una propuesta a tu medida.</strong></p>"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Texto del botón de contacto",
      "default": "Conversemos tu idea"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Página de contacto"
    },
    {
      "type": "header",
      "content": "Prices in cents"
    },
    {
      "type": "number",
      "id": "a5_price",
      "label": "Precio de 12,5 × 18 cm",
      "default": 25000000
    },
    {
      "type": "number",
      "id": "a4_price",
      "label": "Precio de 22,9 × 30,5 cm",
      "default": 40000000
    },
    {
      "type": "number",
      "id": "extra_subject_price",
      "label": "Precio por elemento adicional",
      "default": 3000000
    },
    {
      "type": "number",
      "id": "balanced_price",
      "label": "Detallado · pequeño",
      "default": 6000000
    },
    {
      "type": "number",
      "id": "fine_price",
      "label": "Minucioso · pequeño",
      "default": 12000000
    },
    {
      "type": "number",
      "id": "balanced_large_price",
      "label": "Detallado · grande",
      "default": 9000000
    },
    {
      "type": "number",
      "id": "fine_large_price",
      "label": "Minucioso · grande",
      "default": 18000000
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:schema.sections.commission_form"
    }
  ]
}
{% endschema %}
