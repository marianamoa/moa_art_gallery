<section class="page-width">
  <header class="page-header"><h1>{{ section.settings.heading }}</h1></header>
  <div class="product-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <article class="product-card">
          <a class="product-card__link" href="{{ collection.url }}">
            <div class="product-card__media">{%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 540, 900', sizes: '(min-width: 991px) 25vw, 50vw', alt: collection.featured_image.alt | default: collection.title }}{%- else -%}<div class="placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>{%- endif -%}</div>
            <div class="product-card__content"><h2 class="product-card__title">{{ collection.title }}</h2><p class="product-card__meta">{{ 'collections.general.products_count' | t: count: collection.products_count }}</p></div>
          </a>
        </article>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collection list", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Colecciones" }] }
{% endschema %}

