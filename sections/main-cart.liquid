<section class="cart page-width">
  <h1>{{ 'cart.general.title' | t }} ({{ cart.item_count }})</h1>
  {%- if cart.item_count > 0 -%}
    <form class="cart-form" action="{{ routes.cart_url }}" method="post">
      <div>
        {%- for item in cart.items -%}
          <article class="cart-line">
            {%- if item.image -%}<a href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: class: 'cart-line__image', loading: 'lazy', alt: item.image.alt | default: item.product.title }}</a>{%- endif -%}
            <div>
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
              {%- for property in item.properties -%}{%- unless property.last == blank -%}<p class="muted">{{ property.first }}: {{ property.last }}</p>{%- endunless -%}{%- endfor -%}
              <div class="cart-line__controls">
                <div class="quantity" data-quantity>
                  <button type="button" data-quantity-action="decrease" aria-label="{{ 'accessibility.decrease_quantity' | t }}">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" data-quantity-action="increase" aria-label="{{ 'accessibility.increase_quantity' | t }}">+</button>
                </div>
                <a class="text-link" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a>
              </div>
            </div>
            <div class="cart-line__price">
              {%- if item.original_final_line_price != item.final_line_price -%}<s>{% render 'money', amount: item.original_final_line_price %}</s>{%- endif -%}
              <div>{% render 'money', amount: item.final_line_price %}</div>
              {%- for discount in item.line_level_discount_allocations -%}<span class="meta">{{ discount.discount_application.title }} −{% render 'money', amount: discount.amount %}</span>{%- endfor -%}
            </div>
          </article>
        {%- endfor -%}
        <button class="button" type="submit" name="update">{{ 'cart.general.update' | t }}</button>
      </div>
      <aside class="cart-summary">
        <div class="cart-summary__row"><span>{{ 'cart.general.subtotal' | t }}</span><strong>{% render 'money', amount: cart.items_subtotal_price %}</strong></div>
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}<div class="cart-summary__row"><span>{{ discount.title }}</span><strong>−{% render 'money', amount: discount.total_allocated_amount %}</strong></div>{%- endfor -%}
        {%- endif -%}
        <div class="cart-summary__row muted"><span>{{ 'cart.general.shipping' | t }}</span></div>
        <div class="cart-summary__row cart-summary__total"><span>{{ 'cart.general.total' | t }}</span><strong>{% render 'money', amount: cart.total_price %}</strong></div>
        <button class="button button--primary" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button>
      </aside>
    </form>
  {%- else -%}
    <div class="empty-state"><p class="lead">{{ 'cart.general.empty' | t }}</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue' | t }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "t:schema.sections.main_cart", "settings": [] }
{% endschema %}
