<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body style="--paper:#F6F3EE;--paper-deep:#ECE6DD;--ink:#1F1D1A;--ink-soft:#4A463F;--ink-muted:#635E54;--studio:#4E5E6B;--low-stock:#8A4F3C;--font-heading:Georgia,serif;--font-body:Arial,sans-serif;--page-width:1200px">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>

