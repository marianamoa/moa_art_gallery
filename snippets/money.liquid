{% doc %}
Renders a monetary amount using the merchant's currency-code preference.
@param {number} amount - Monetary value in Shopify currency subunits
{% enddoc %}

{%- if settings.show_currency_codes -%}
  {{- amount | money_without_trailing_zeros }} {{ cart.currency.iso_code | default: shop.currency -}}
{%- else -%}
  {{- amount | money_without_trailing_zeros -}}
{%- endif -%}
