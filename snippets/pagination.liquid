{% doc %}
Renders pagination links.
@param {paginate} paginate - Shopify paginate object
@param {boolean} [show_labels] - Show previous and next labels beside arrows
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">←{% if show_labels %} {{ 'general.pagination.previous' | t }}{% endif %}</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- else -%}
        {%- assign part_number = part.title | plus: 0 -%}
        <span{% if part_number == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">{% if show_labels %}{{ 'general.pagination.next' | t }} {% endif %}→</a>{%- endif -%}
  </nav>
{%- endif -%}
